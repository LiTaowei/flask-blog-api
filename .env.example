# ===== Flask 配置 =====
# 请替换为随机字符串（可用 python -c "import secrets;print(secrets.token_hex(32))" 生成）
SECRET_KEY=replace-with-a-random-secret-key
# 本地调试设为 1，生产环境保持 0
FLASK_DEBUG=1

# ===== 数据库连接串 =====
# 格式：mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:your-password@localhost:3306/blog_db?charset=utf8mb4

# ===== JWT 配置 =====
# 请替换为随机字符串（建议至少 32 位）
JWT_SECRET_KEY=replace-with-a-random-jwt-secret
